# Server port
PORT=5000

# PostgreSQL database connection strings (Supabase / PostgreSQL)
DATABASE_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:6543/YOUR_DB_NAME?pgbouncer=true"
DIRECT_URL="postgresql://YOUR_DB_USER:YOUR_DB_PASSWORD@YOUR_DB_HOST:5432/YOUR_DB_NAME"

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_here

# Google Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here